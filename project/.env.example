# Vectorize Hindsight Cloud Configuration
HINDSIGHT_API_KEY="your-hindsight-cloud-api-key"
HINDSIGHT_API_URL="https://api.vectorize.io/v1/hindsight"
HINDSIGHT_MEMORY_BANK_ID="mb_infrapulse_sre_prod_01"

# LLM Providers
# Groq (Primary LLM for fast inference & reasoning)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="qwen/qwen3-32b" # or openai/gpt-oss-120b, llama-3.3-70b-versatile

# Fallback LLM & Search Grounding
GEMINI_API_KEY="your-gemini-api-key"

# Server & App Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
FRONTEND_PORT="8501"
LOG_LEVEL="INFO"
ENVIRONMENT="production"
